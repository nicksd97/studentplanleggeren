# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# paid planner PDFs (public repo) — keep source copies here, never commit them
/assets/source/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# PDF translation build output (paid PDFs — never commit)
/scripts/pdf-i18n/source/
/scripts/pdf-i18n/out/
/scripts/pdf-i18n/png/
/scripts/pdf-i18n/fonts/
/scripts/pdf-i18n/build-info/
/scripts/pdf-i18n/verify-report.json
__pycache__/
